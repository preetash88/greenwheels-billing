        {
          "name": "HP-05 - Get billing summary for driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has all summary fields', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('driver_id');",
                  "  pm.expect(body).to.have.property('total_billed');",
                  "  pm.expect(body).to.have.property('total_paid');",
                  "  pm.expect(body).to.have.property('total_outstanding');",
                  "  pm.expect(body).to.have.property('missed_payment_count');",
                  "  pm.expect(body).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('Total paid equals seed payments plus week 3 payment', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.total_paid).to.eql(10500);",
                  "});",
                  "",
                  "pm.test('Outstanding is non-negative', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.total_outstanding).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test('Status is ok — not overdue yet', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],

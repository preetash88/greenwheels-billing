{
  "info": {
    "name": "Greenwheels Billing Cycle API",
    "_postman_id": "greenwheels-billing-v1",
    "description": "Full test suite for the Greenwheels Billing Cycle feature. Covers happy paths, all 5 business rules, and negative/edge cases. Runnable via Newman in CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "00 - Setup",
      "description": "Reset the stub service before every test run to restore seed data.",
      "item": [
        {
          "name": "SETUP - Reset stub service",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reset returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Reset confirms drivers loaded', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('reset');",
                  "  pm.expect(body.drivers_loaded).to.be.above(0);",
                  "  pm.expect(body.events_loaded).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/test/reset",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "test",
                "reset"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Happy Path",
      "description": "One happy path test per endpoint. Verifies basic success behaviour and correct response structure.",
      "item": [
        {
          "name": "HP-01 - Create billing cycle for active driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('invoice_id');",
                  "  pm.expect(body).to.have.property('amount_due');",
                  "  pm.expect(body).to.have.property('currency');",
                  "  pm.expect(body).to.have.property('due_date');",
                  "  pm.expect(body).to.have.property('status');",
                  "});",
                  "",
                  "pm.test('Currency is KES', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.currency).to.eql('KES');",
                  "});",
                  "",
                  "pm.test('Amount due is correct weekly amount', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.amount_due).to.eql(3500);",
                  "});",
                  "",
                  "pm.test('Status is pending', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('pending');",
                  "});",
                  "",
                  "// Save invoice_id for use in payment tests",
                  "const body = pm.response.json();",
                  "pm.environment.set('invoice_id', body.invoice_id);",
                  "pm.environment.set('week3_invoice_id', body.invoice_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driver_id\": \"{{active_driver_id}}\",\n  \"week\": 3,\n  \"currency\": \"{{currency}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/billing/cycles",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "billing",
                "cycles"
              ]
            }
          }
        },
        {
          "name": "HP-02 - Record payment against invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has required fields', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('payment_reference');",
                  "  pm.expect(body).to.have.property('invoice_id');",
                  "  pm.expect(body).to.have.property('amount');",
                  "  pm.expect(body).to.have.property('status');",
                  "  pm.expect(body).to.have.property('message');",
                  "});",
                  "",
                  "pm.test('Payment status is recorded', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('recorded');",
                  "});",
                  "",
                  "pm.test('Payment reference matches request', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.payment_reference).to.eql('PAY-HP-001');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": \"{{week3_invoice_id}}\",\n  \"payment_reference\": \"PAY-HP-001\",\n  \"amount\": 3500,\n  \"currency\": \"{{currency}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/billing/payments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "billing",
                "payments"
              ]
            }
          }
        },
        {
          "name": "HP-03 - List billing cycles for driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has driver_id and cycles array', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('driver_id');",
                  "  pm.expect(body).to.have.property('cycles');",
                  "  pm.expect(body.cycles).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each cycle has required fields', function () {",
                  "  const body = pm.response.json();",
                  "  body.cycles.forEach(function(cycle) {",
                  "    pm.expect(cycle).to.have.property('invoice_id');",
                  "    pm.expect(cycle).to.have.property('week');",
                  "    pm.expect(cycle).to.have.property('amount_due');",
                  "    pm.expect(cycle).to.have.property('currency');",
                  "    pm.expect(cycle).to.have.property('due_date');",
                  "    pm.expect(cycle).to.have.property('status');",
                  "  });",
                  "});",
                  "",
                  "pm.test('Driver has at least one cycle', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.cycles.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Week 3 cycle is paid', function () {",
                  "  const body = pm.response.json();",
                  "  const week3 = body.cycles.find(c => c.week === 3);",
                  "  pm.expect(week3).to.not.be.undefined;",
                  "  pm.expect(week3.status).to.eql('paid');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/billing/cycles/{{active_driver_id}}",
              "host": [
                "{{base_url}}"
